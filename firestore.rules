rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // System configuration (Admin credentials, etc.)
    match /system/{documentId} {
      allow read, write: if true;
    }

    // Rules for storeSettings collection (currency, tax, shipping fee, etc.)
    match /storeSettings/{documentId} {
      allow read, write: if true;
    }

    // Rules for the products collection
    match /products/{productId} {
      allow read, write: if true;
    }

    // Rules for the categories collection
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Rules for the orders collection
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Rules for the users collection
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
